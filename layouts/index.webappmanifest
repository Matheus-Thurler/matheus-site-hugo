{{- $themeColor := site.Params.themeColor | default "#0c1116" -}}
{{- $icons := slice
  (dict "src" (site.Params.favicon.svg | default "/favicon.svg") "sizes" "any" "type" "image/svg+xml")
  (dict "src" "/images/avatar.png" "sizes" "512x512" "type" "image/png")
-}}
{{- $manifest := dict
  "name" site.Title
  "short_name" (site.Params.shortName | default site.Title)
  "description" (or site.Params.description "")
  "start_url" site.Home.RelPermalink
  "display" "standalone"
  "background_color" $themeColor
  "theme_color" $themeColor
  "orientation" "portrait-primary"
  "lang" site.Language.LanguageCode
  "dir" "ltr"
  "scope" "/"
  "categories" (slice "blog" "technology" "education")
  "icons" $icons
-}}
{{- $manifest | jsonify (dict "indent" "  ") -}}
