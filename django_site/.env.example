# Django
DEBUG=False
DJANGO_SECRET_KEY=change-me-use-openssl-rand-hex-32
ALLOWED_HOSTS=localhost,127.0.0.1,web
WEB_PORT=8000

# Database — sqlite (default) or postgresql
DB_ENGINE=sqlite
DATABASE_PATH=/app/data/db.sqlite3

# PostgreSQL (docker compose -f docker-compose.postgres.yml)
# DB_ENGINE=postgresql
# POSTGRES_HOST=db
# POSTGRES_DB=blog
# POSTGRES_USER=blog
# POSTGRES_PASSWORD=blog
# POSTGRES_PORT=5432

# Analytics (loaded only after cookie consent)
ANALYTICS_ENABLED=True
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GOOGLE_ADSENSE_ID=pub-XXXXXXXXXX

# OAuth — configure via admin / Secret Manager, never commit real values
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Newsletter (Django app — replaces content-automation subscribe Cloud Function)
