{
  "hosting": {
    "public": "hosting/public",
    "cleanUrls": true,
    "trailingSlash": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/admin/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "private, no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/posts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "/pt/posts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=120, s-maxage=600, stale-while-revalidate=3600"
          }
        ]
      },
      {
        "source": "/pt/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=120, s-maxage=600, stale-while-revalidate=3600"
          }
        ]
      },
      {
        "source": "/categories/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, s-maxage=1800, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "/tags/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, s-maxage=1800, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "/about/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
          }
        ]
      },
      {
        "source": "/privacy/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
          }
        ]
      },
      {
        "source": "/terms/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "matheus-blog",
          "region": "southamerica-east1",
          "pinTag": true
        }
      }
    ]
  }
}
